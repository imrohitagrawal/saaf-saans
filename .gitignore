.env
__pycache__/
*.pyc
.pytest_cache/

# The viewport probe's local counter file, and SQLite's write-ahead log
# sidecars. A local run creates it in the working directory; production keeps
# it on a Fly volume.
viewport-counts.sqlite3
viewport-counts.sqlite3-*
.venv/
venv/

# Local-only notes: drafts, personal write-ups. Never pushed.
/private/

# macOS Finder metadata. Three of these were tracked before this entry
# existed, so they are removed from the index in the same commit.
.DS_Store

# Agent worktrees created by docs/fix-workflow.js. Transient, and each is
# a git checkout of its own -- committing them embeds repos inside this one.
.claude/worktrees/

# Agent tooling, vendored per-machine and not part of the product. Untracked by
# intent -- a `git add -A` once swept 151 files and 71,000 lines of it into a
# feature branch, burying a 350-line change at 200:1. Ignored so that cannot
# happen again rather than remembered.
.claude/
.impeccable/
