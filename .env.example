# --- Elasticsearch (choose ONE connection style) ---
# Classic Elastic Cloud: set cloud id + api key
ELASTIC_CLOUD_ID=
# OR Elastic Serverless / self-managed: set an https endpoint URL + api key
ELASTIC_URL=
ELASTIC_API_KEY=

# --- OpenRouter (Gemini) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- WAQI live air-quality feed ---
WAQI_TOKEN=

# --- Where the viewport probe keeps its page-load counts ---
# Defaults to viewport-counts.sqlite3 in the working directory. Production sets
# it to a path on a mounted volume, because the container filesystem is
# replaced on every deploy.
SAAFSAANS_VIEWPORT_DB=

# NOTE: With none of these set, the app still runs fully offline in mock mode.
