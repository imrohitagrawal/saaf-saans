# Everything the image does not need. Keeping it small is secondary; keeping
# secrets and local state out of it is the point.
.env
.venv/
.git/
.github/
__pycache__/
*.pyc
.pytest_cache/
# A developer's local page-load counts are not part of the image.
viewport-counts.sqlite3*
tests/
docs/
private/
design_handoff_saafsaans/
*.md
!requirements.txt
