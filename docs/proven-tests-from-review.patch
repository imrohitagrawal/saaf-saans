+def test_a_malformed_later_row_cannot_blank_a_station_timestamp(feed):
+    """``_group`` keeps the FIRST ``last_update`` that parses, and the reason is
+    the failure mode of keeping the last one.
+
+    The feed sends one row per pollutant per station, and every row for a
+    station carries the same last_update -- except when one of them does not. A
+    rule that overwrites on every row lets whichever row arrives last decide,
+    and when that row's date is unparseable the station loses its timestamp
+    altogether: ``obs_time`` becomes None, which ``waqi._obs_too_old`` reads as
+    "no evidence either way" and passes as fresh. So one malformed row does not
+    merely lose a timestamp -- it removes the freshness check from the station it
+    belongs to, which is the reading most in need of one.
+    """
+    records = [
+        {"station": "ITO, Delhi - CPCB", "city": "Delhi", "pollutant_id": "PM2.5",
+         "avg_value": "53", "last_update": FRESH_CPCB_WHEN},
+        {"station": "ITO, Delhi - CPCB", "city": "Delhi", "pollutant_id": "PM10",
+         "avg_value": "63", "last_update": "not a date"},
+    ]
+    feed(records)
+    values = cpcb.values_for("ITO")
+    assert values["obs_time"] == cpcb._obs_time(FRESH_CPCB_WHEN), \
+        "a malformed later row blanked the station's own timestamp"
+
+
+def test_when_two_rows_state_different_times_the_first_one_stands(feed):
+    """The same rule with no malformed row in it.
+
+    The test above catches "overwrite on every row" only because its last row
+    fails to parse, and a real payload need not contain one. This pins the rule
+    itself: two parseable, disagreeing timestamps, and it is the first that the
+    station keeps.
+    """
+    second_row = (clock.now_ist() - timedelta(hours=4)).strftime("%d-%m-%Y %H:%M:%S")
+    assert cpcb._obs_time(second_row) != cpcb._obs_time(FRESH_CPCB_WHEN)
+    feed(rows("ITO, Delhi - CPCB", pm25=53, when=FRESH_CPCB_WHEN)
+         + rows("ITO, Delhi - CPCB", pm10=63, when=second_row))
+    assert cpcb.values_for("ITO")["obs_time"] == cpcb._obs_time(FRESH_CPCB_WHEN), \
+        "a later row overwrote the timestamp the station had already stated"
+
